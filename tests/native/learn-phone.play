# Generated by tools/gen-plays.mjs. The lesson (Learn) on a portrait phone:
# Next, letters spelled by touch on the wheel's named letters, a word planted,
# a wrong word, Shuffle, Hint, the closing step, then the rest of the grove
# typed; the results.
# viewport 390x844@3
until 600 Word
frames 30
touch Learn & play
until 600 Welcome to the Grove
frames 30
save wg-learn-phone
touch =Next
until 120 Connect letters
frames 10
touch Letter I
frames 6
touch Letter D
frames 6
touch Letter E
frames 6
touch Letter A
frames 6
frames 10
touch Submit word
until 120 Try a word
frames 10
key KeyL 1
frames 3
key KeyD 1
frames 3
key KeyI 1
frames 3
key Enter 1
until 120 Shuffling only
frames 10
touch Shuffle
until 120 Stuck?
frames 30
touch Hint
until 120 Off you go
frames 10
save wg-learn-phone-2
touch =Play!
frames 10
key KeyI 1
frames 3
key KeyD 1
frames 3
key KeyE 1
frames 3
key KeyA 1
frames 3
key KeyL 1
frames 3
key Enter 1
frames 20
key KeyL 1
frames 3
key KeyE 1
frames 3
key KeyD 1
frames 3
key Enter 1
frames 20
key KeyL 1
frames 3
key KeyI 1
frames 3
key KeyE 1
frames 3
key Enter 1
frames 20
until 600 Total
frames 60
save wg-learn-results
